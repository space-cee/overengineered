            <token name="RunContext">0</token>
            <bool name="DefinesCapabilities">false</bool>
            <string name="Source">local dragDetector = script.Parent
local part = dragDetector.Parent

if not part:IsA("BasePart") then
	dragDetector.Enabled = false
	return
end

local function updateDetectorState()
	if (not part.Anchored) and part.CanCollide then
		dragDetector.Enabled = true
	else
		dragDetector.Enabled = false
	end
end

part:GetPropertyChangedSignal("Anchored"):Connect(updateDetectorState)
part:GetPropertyChangedSignal("CanCollide"):Connect(updateDetectorState)

updateDetectorState()</string>
            <int64 name="SourceAssetId">-1</int64>
